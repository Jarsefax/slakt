{
  "display_information": {
    "name": "slakt",
    "description": "A personal terminal client for Slack",
    "background_color": "#271E36"
  },
  "oauth_config": {
    "redirect_urls": ["http://localhost:8765/callback"],
    "scopes": {
      "user": [
        "channels:read", "channels:history", "groups:read", "groups:history",
        "im:read", "im:history", "im:write", "mpim:read", "mpim:history",
        "users:read", "chat:write", "search:read", "reactions:write"
      ]
    },
    "pkce_enabled": true
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
